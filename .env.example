# MySQL Database Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=liveexam_db
# Set to true for cloud MySQL providers (Aiven, TiDB Cloud, etc.)
MYSQL_SSL=false

# Authentication secret for JWT session tokens
AUTH_SECRET=liveexam_secret_key_2026_secure_sha256

# Port configuration
PORT=3005

